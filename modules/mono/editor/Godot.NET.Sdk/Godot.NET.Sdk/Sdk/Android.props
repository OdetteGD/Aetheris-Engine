<Project>
  <!-- Android C# projects use the Mono runtime by default. The export pipeline
       supplies the exact architecture-specific RID. -->
  <PropertyGroup>
    <UseMonoRuntime Condition=" '$(UseMonoRuntime)' == '' and '$(PublishAot)' != 'true' ">true</UseMonoRuntime>

    <!-- Command-line Android C# builds can select an architecture without
         replacing an explicit RuntimeIdentifier supplied by the exporter. -->
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' and '$(GodotAndroidArchitecture)' == 'arm64' ">android-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' and '$(GodotAndroidArchitecture)' == 'arm32' ">android-arm</RuntimeIdentifier>
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' and '$(GodotAndroidArchitecture)' == 'x86_64' ">android-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' and '$(GodotAndroidArchitecture)' == 'x86_32' ">android-x86</RuntimeIdentifier>
  </PropertyGroup>
</Project>
